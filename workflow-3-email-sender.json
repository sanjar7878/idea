            "email_sent": "={{ $json.send_type === 'cold' ? new Date().toISOString() : $json.email_sent }}",
            "followup_sent": "={{ $json.send_type === 'followup' ? new Date().toISOString() : '' }}"
          },
          "matchingColumns": ["business_name"],
          "schema": []
        },
        "options": {}
      },
