{
  "modules": [
    {
      "id": 1,
      "module": "google-sheets:SearchRows",
      "version": 2,
      "parameters": {
        "spreadsheetId": "REPLACE_YOUR_SPREADSHEET_ID",
        "sheetId": "CLIENTS",
        "includeColumnHeaders": true
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 200,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://maps.googleapis.com/maps/api/place/details/json",
        "method": "get",
        "qs": [
          {
            "name": "place_id",
            "value": "{{1.google_place_id}}"
          },
          {
            "name": "fields",
            "value": "name,rating,reviews,user_ratings_total"
          },
          {
            "name": "key",
            "value": "REPLACE_YOUR_GOOGLE_PLACES_API_KEY"
          },
          {
            "name": "language",
            "value": "en"
          }
        ],
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 400,
          "y": -100
        }
      }
    },
    {
      "id": 4,
      "module": "google-sheets:SearchRows",
      "version": 2,
      "parameters": {
        "spreadsheetId": "REPLACE_YOUR_SPREADSHEET_ID",
        "sheetId": "REVIEWS",
        "includeColumnHeaders": true
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": -100
        }
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{3.data.result.reviews}}"
      },
      "metadata": {
        "designer": {
          "x": 800,
          "y": -100
        }
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 1000,
          "y": -100
        }
      }
    },
    {
      "id": 7,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "post",
        "headers": [
          {
            "name": "x-api-key",
            "value": "REPLACE_YOUR_ANTHROPIC_API_KEY"
          },
          {
            "name": "anthropic-version",
            "value": "2023-06-01"
          },
          {
            "name": "content-type",
            "value": "application/json"
          }
        ],
        "body": "{\"model\":\"claude-3-5-sonnet-20241022\",\"max_tokens\":300,\"messages\":[{\"role\":\"user\",\"content\":\"Write a professional Google review response for {{1.business_name}}. Reviewer: {{5.author_name}}. Stars: {{5.rating}}/5. Review: {{5.text}}. If 4-5 stars: warm grateful response under 60 words. If 1-3 stars: calm empathetic response inviting them to call, under 80 words. Never mention AI. Sign off as The Team at {{1.business_name}}. Return only the response text.\"}]}",
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": -200
        }
      }
    },
    {
      "id": 8,
      "module": "google-sheets:ActionAddRow",
      "version": 2,
      "parameters": {
        "spreadsheetId": "REPLACE_YOUR_SPREADSHEET_ID",
        "sheetId": "REVIEWS",
        "includeColumnHeaders": true
      },
      "mapper": {
        "values": {
          "client_name": "{{1.client_name}}",
          "review_date": "{{formatDate(now; \"YYYY-MM-DD\")}}",
          "star_rating": "{{5.rating}}",
          "review_text": "{{5.text}}",
          "suggested_response": "{{7.data.content[].text}}",
          "response_posted": "",
          "platform": "Google",
          "reviewer_name": "{{5.author_name}}",
          "review_fingerprint": "{{5.author_name}}_{{5.time}}_{{1.client_name}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1400,
          "y": -200
        }
      }
    },
    {
      "id": 9,
      "module": "telegram-bot:ActionSendMessage",
      "version": 1,
      "parameters": {
        "token": "REPLACE_YOUR_TELEGRAM_BOT_TOKEN",
        "chatId": "REPLACE_YOUR_TELEGRAM_CHAT_ID"
      },
      "mapper": {
        "text": "{{repeatString(\"⭐\"; 5.rating)}}\n\n🏢 {{1.business_name}}\n👤 {{5.author_name}} · {{5.rating}}/5 stars\n\n📝 Review:\n{{5.text}}\n\n💬 Suggested Response:\n{{7.data.content[].text}}",
        "parse_mode": "HTML"
      },
      "metadata": {
        "designer": {
          "x": 1600,
          "y": -200
        }
      }
    }
  ],
  "routes": [
    {
      "flow": [
        {
          "id": 1
        },
        {
          "id": 2
        }
      ]
    },
    {
      "flow": [
        {
          "id": 3
        },
        {
          "id": 4
        },
        {
          "id": 5
        },
        {
          "id": 6
        }
      ],
      "condition": {
        "expression": "{{and(equals(1.status; \"active\"); notEmpty(1.google_place_id))}}"
      }
    },
    {
      "flow": [
        {
          "id": 7
        },
        {
          "id": 8
        },
        {
          "id": 9
        }
      ],
      "condition": {
        "expression": "{{not(contains(4.review_fingerprint; concat(5.author_name; \"_\"; 5.time; \"_\"; 1.client_name)))}}"
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    }
  }
}