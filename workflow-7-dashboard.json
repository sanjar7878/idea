        }
      }
    },
    {
      "id": "readReviews",
      "name": "Read Reviews Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [500, 600],
      "parameters": {
        "operation": "readRows",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "REVIEWS",
          "mode": "name"
        },
        "filters": {},
