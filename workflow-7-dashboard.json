{
  "name": "07 — Dashboard Data Updater",
  "nodes": [
    {
      "id": "note1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [250, 80],
      "parameters": {
        "content": "## 📈 Dashboard Data Updater\n\nRuns every hour automatically.\n\nCalculates and writes to DASHBOARD tab:\n- Total leads\n- Emails sent this week\n- Total paying clients\n- Monthly revenue estimate\n- Reviews responded this week\n- Last updated timestamp\n\n**Credentials needed:**\n- Google Sheets OAuth",
        "height": 250,
        "width": 400,
        "color": 7
      }
    },
    {
      "id": "schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "readLeads",
      "name": "Read Leads Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [500, 200],
      "parameters": {
        "operation": "readRows",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "LEADS",
          "mode": "name"
        },
        "filters": {},
        "options": {
          "returnAllColumns": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "readClients",
      "name": "Read Clients Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [500, 400],
      "parameters": {
        "operation": "readRows",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "CLIENTS",
          "mode": "name"
        },
        "filters": {},
        "options": {
          "returnAllColumns": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CREDENTIAL_ID",
