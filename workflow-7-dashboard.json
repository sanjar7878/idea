    {
      "id": "mergeData",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 400],
      "parameters": {
        "jsCode": "// Get data from all three sheets\n// Since nodes run sequentially, we access them by name\nconst leads = $('Read Leads Sheet').all().map(i => i.json);\nconst clients = $('Read Clients Sheet').all().map(i => i.json);\nconst reviews = $('Read Reviews Sheet').all().map(i => i.json);\n\n// Calculate metrics\nconst totalLeads = leads.length;\n\n// Emails sent this week\nconst oneWeekAgo = new Date();\noneWeekAgo.setDate(oneWeekAgo.getDate() - 7);\nconst emailsSentThisWeek = leads.filter(l => {\n  if (!l.email_sent) return false;\n  const d = new Date(l.email_sent);\n  return d >= oneWeekAgo;\n}).length;\n\n// Active clients\nconst activeClients = clients.filter(c => c.status === 'active');\nconst totalClients = activeClients.length;\n\n// Monthly revenue\nconst avgFee = 275; // Default average fee £275\nconst totalFees = activeClients.reduce((sum, c) => sum + (parseFloat(c.fee) || avgFee), 0);\nconst monthlyRevenue = totalFees;\n\n// Reviews responded this week\nconst reviewsThisWeek = reviews.filter(r => {\n  if (!r.review_date) return false;\n  const d = new Date(r.review_date);\n  return d >= oneWeekAgo;\n});\nconst reviewsRespondedThisWeek = reviewsThisWeek.filter(r => r.response_posted && r.response_posted !== '').length;\nconst newReviewsThisWeek = reviewsThisWeek.length;\n\nreturn [{\n  json: {\n    total_leads: totalLeads,\n    emails_sent_this_week: emailsSentThisWeek,\n    total_clients: totalClients,\n    monthly_revenue: monthlyRevenue.toFixed(2),\n    reviews_responded_this_week: reviewsRespondedThisWeek,\n    new_reviews_this_week: newReviewsThisWeek,\n    last_updated: new Date().toLocaleString('en-GB')\n  }\n}];"
      }
    },
    {
      "id": "updateDashboard",
      "name": "Update Dashboard Tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1000, 400],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "DASHBOARD",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "metric": "CURRENT",
            "total_leads": "={{ $json.total_leads }}",
            "emails_sent_this_week": "={{ $json.emails_sent_this_week }}",
            "total_clients": "={{ $json.total_clients }}",
            "monthly_revenue": "={{ '£' + $json.monthly_revenue }}",
            "reviews_responded_this_week": "={{ $json.reviews_responded_this_week }}",
            "new_reviews_this_week": "={{ $json.new_reviews_this_week }}",
            "last_updated": "={{ $json.last_updated }}"
          },
          "matchingColumns": ["metric"],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    }
  ],
